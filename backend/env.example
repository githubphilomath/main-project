# Azure OpenAI Configuration (chat/LLM)
# Get these from your Azure OpenAI resource in the Azure portal
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4

# Gemini Configuration (embeddings only - RAG)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-001

# Database Configuration
# For local development with Docker Compose, use the default below
# For production, update with your actual PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_platform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Chroma Configuration
# For local development with Docker Compose, use localhost
# For production, update with your ChromaDB host
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_KNOWLEDGE=knowledge_base
CHROMA_COLLECTION_MEMORY=project_memory
CHROMA_COLLECTION_VERSION=approval_version

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Options: json (for production) or console (for development)
LOG_FORMAT=json

# Agent Configuration
MAX_RETRIES=3
RETRY_DELAY=1.0
AGENT_TIMEOUT=300

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

