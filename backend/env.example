# Azure OpenAI Configuration (chat/LLM)
# Get these from your Azure OpenAI resource in the Azure portal
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4

# Gemini Configuration (embeddings only - used for RAG vector search)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_platform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Chroma Configuration (port 8010 to avoid conflict with API on 8000)
CHROMA_HOST=localhost
CHROMA_PORT=8010
CHROMA_COLLECTION_KNOWLEDGE=knowledge_base
CHROMA_COLLECTION_MEMORY=project_memory
CHROMA_COLLECTION_VERSION=approval_version

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Agent Configuration
MAX_RETRIES=3
RETRY_DELAY=1.0
AGENT_TIMEOUT=300

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

